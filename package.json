{
  "name": "@kevinmarrec/config",
  "version": "1.22.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "author": "Kevin Marrec <kevin@marrec.io>",
  "license": "MIT",
  "homepage": "https://github.com/kevinmarrec/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinmarrec/config.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run check:unused && bun run check:types",
    "check:types": "tsc --noEmit",
    "check:unused": "knip -n",
    "lint": "bun run lint:eslint && bun run lint:stylelint",
    "lint:eslint": "eslint . --cache",
    "lint:inspect": "bunx @eslint/config-inspector",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "release": "bumpp",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.2.3",
    "eslint": "^10.9.0",
    "knip": "^6.34.0",
    "stylelint": "^17.14.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
