{
  "description": "Default config",
  "schedule": ["* 3-8 * * 6"],
  "timezone": "Europe/Paris",
  "extends": [
    ":configMigration",
    ":dependencyDashboard",
    ":disablePeerDependencies",
    ":ignoreModulesAndTests",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "group:allNonMajor",
    "mergeConfidence:age-confidence-badges",
    "replacements:all",
    "workarounds:all"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "schedule": ["at any time"]
    },
    {
      "groupName": "docker dependencies",
      "groupSlug": "docker",
      "matchDatasources": ["docker"]
    },
    {
      "description": "vitest and @vitest/coverage-v8 pin each other exactly, so a major that moves only one of them can never go green.",
      "extends": ["monorepo:vitest"],
      "groupName": "vitest"
    },
    {
      "description": "Auto-merge kevinmarrec/workflows updates, as they are self-owned and CI-verified. Not in the workflows repo itself, where the ref pins that repo's own main: every merge moves main, so the digest can never settle.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["kevinmarrec/workflows", "kevinmarrec/workflows/**"],
      "matchRepositories": ["!kevinmarrec/workflows"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 3-8 8-14 * 0"]
  },
  "prHourlyLimit": 10,
  "commitBodyTable": true,
  "labels": ["dependencies"],
  "reviewers": ["kevinmarrec"]
}
